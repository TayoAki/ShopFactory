{
  "name": "bogey-baby-backend",
  "version": "0.0.1",
  "description": "Medusa v2 backend for the Bogey Baby store.",
  "author": "Bogey Baby",
  "license": "MIT",
  "keywords": [
    "medusa",
    "ecommerce",
    "bogey-baby"
  ],
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "seed": "medusa exec ./src/scripts/seed-bogey-baby.ts",
    "predeploy": "medusa db:migrate && (medusa user -e \"$MEDUSA_ADMIN_EMAIL\" -p \"$MEDUSA_ADMIN_PASSWORD\" || true) && medusa exec ./src/scripts/seed-bogey-baby.js"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.7",
    "@medusajs/cli": "2.22.7",
    "@medusajs/framework": "2.22.7",
    "@medusajs/medusa": "2.22.7"
  },
  "devDependencies": {
    "@swc/core": "^1.7.28",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": "22.x"
  }
}
