# Public site settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pre-launch "drop mode": waitlist instead of add-to-bag across the site (true/false)
NEXT_PUBLIC_DROP_MODE=false
NEXT_PUBLIC_DROP_DATE=
# Let search engines index the site (set true only at launch)
NEXT_PUBLIC_INDEXABLE=false
# Checkout: "demo" shows the full flow without taking payment. Wire Stripe before setting "live".
NEXT_PUBLIC_CHECKOUT_MODE=demo

# Server-only (never prefix with NEXT_PUBLIC_)
# Klaviyo private key for waitlist/newsletter signups (optional; signups are logged without it)
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
# Printify (only needed by scripts that sync the catalog; not used at runtime)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=29796342

# Medusa backend (backend/). Publishable keys are safe in the browser.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://medusa-production-d5c770da.up.railway.app
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
